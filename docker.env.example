# Docker Compose settings. Copy this file to .env before starting the stack.
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=taskflow_dev_password
MYSQL_ROOT_PASSWORD=taskflow_root_dev_password

# Replace this value with a long random secret before deployment.
JWT_SECRET=change-this-taskflow-jwt-secret
JWT_EXPIRES_IN=7d
PASSWORD_RESET_SECRET=replace-this-with-a-long-random-secret

# Gmail SMTP password reset email. Use a Google App Password, not your account password.
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# The API URL is embedded into the frontend during its image build.
NEXT_PUBLIC_API_URL=http://localhost:5001/api
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
API_PORT=5001
