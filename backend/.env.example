# Environment variables for TaskFlow backend
NODE_ENV=development
PORT=5001

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=taskflow

# JWT
JWT_SECRET=replace_with_a_random_secret_of_32_characters_or_more
JWT_EXPIRES_IN=7d
PASSWORD_RESET_SECRET=replace_with_a_different_random_secret_of_32_characters_or_more

# Local development admin only. Never use these credentials for a deployed instance.
# Set all four values together; deployments should use a real email and a unique password.
ADMIN_NAME=TaskFlow Administrator
ADMIN_EMAIL=admin@taskflow.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TaskFlow-Local-Admin-2026!

# Password reset email (Gmail SMTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# CORS
FRONTEND_URL=http://localhost:3000

# Number of reverse proxies (load balancer, nginx) in front of the API. 0 when exposed directly.
TRUST_PROXY=0
