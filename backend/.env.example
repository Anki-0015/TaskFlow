# Environment variables for TaskFlow backend
NODE_ENV=development
PORT=5001

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=taskflow

# JWT
JWT_SECRET=taskflow_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
PASSWORD_RESET_SECRET=replace_with_a_long_random_secret

# Password reset email (Gmail SMTP)
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# CORS
FRONTEND_URL=http://localhost:3000
