# Environment variables for TaskFlow backend
NODE_ENV=development
PORT=5001

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=taskflow

# JWT
JWT_SECRET=replace_with_a_random_secret_of_32_characters_or_more
JWT_EXPIRES_IN=7d
PASSWORD_RESET_SECRET=replace_with_a_different_random_secret_of_32_characters_or_more

# Password reset email (Gmail SMTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# CORS
FRONTEND_URL=http://localhost:3000
